    "/tools/create_ticket": {
      "post": {
        "tags": [
          "agent-tools"
        ],
        "summary": "Create Ticket Tool",
        "description": "仅当当前用户原文等于草稿确认短语时创建工单。上下文和原文必须由 Dify 手动绑定。重复调用返回原工单。",
        "operationId": "create_ticket",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "user_id": {
                    "type": "string",
                    "maxLength": 200,
                    "minLength": 1,
                    "pattern": "\\S",
                    "title": "User Id",
                    "description": "手动绑定 Dify sys.user_id，禁止由模型生成"
                  },
                  "conversation_id": {
                    "type": "string",
                    "maxLength": 200,
                    "minLength": 1,
                    "pattern": "\\S",
                    "title": "Conversation Id",
                    "description": "手动绑定 Dify sys.conversation_id，禁止由模型生成"
                  },
                  "proposal_id": {
                    "type": "string",
                    "maxLength": 200,
                    "minLength": 1,
                    "pattern": "\\S",
                    "title": "Proposal Id"
                  },
                  "user_message": {
                    "type": "string",
                    "maxLength": 2000,
                    "minLength": 1,
                    "title": "User Message",
                    "description": "手动绑定当前 sys.query 原文，禁止模型生成或改写"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "user_id",
                  "conversation_id",
                  "proposal_id",
                  "user_message"
                ],
                "title": "CreateInput"
