    "/tools/prepare_ticket": {
      "post": {
        "tags": [
          "agent-tools"
        ],
        "summary": "Prepare Ticket Tool",
        "description": "用户要求准备工单草稿时必须调用本工具。成功后才可展示真实草稿号和返回的完整确认短语；禁止自己生成草稿或确认短语。草稿30分钟有效，尚未创建正式工单。",
        "operationId": "prepare_ticket",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "user_id": {
                    "type": "string",
                    "maxLength": 200,
                    "minLength": 1,
                    "pattern": "\\S",
                    "title": "User Id",
                    "description": "手动绑定 Dify sys.user_id，禁止由模型生成"
                  },
                  "conversation_id": {
                    "type": "string",
                    "maxLength": 200,
                    "minLength": 1,
                    "pattern": "\\S",
                    "title": "Conversation Id",
                    "description": "手动绑定 Dify sys.conversation_id，禁止由模型生成"
                  },
                  "order_id": {
                    "type": "string",
                    "maxLength": 200,
                    "minLength": 1,
                    "pattern": "\\S",
                    "title": "Order Id"
                  },
                  "summary": {
                    "type": "string",
                    "maxLength": 1000,
                    "minLength": 5,
                    "pattern": "\\S",
                    "title": "Summary"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "user_id",
                  "conversation_id",
                  "order_id",
                  "summary"
                ],
                "title": "PrepareInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "detail": {
                      "items": {
                        "properties": {
