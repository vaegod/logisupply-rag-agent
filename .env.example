# Dify 已发布 Chatflow 的 API 配置
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_API_KEY=replace-with-your-dify-api-key

# Dify HTTP Request 节点能够访问的订单接口地址
# Dify Cloud 不能访问 127.0.0.1，请替换为公网 HTTPS 地址。
ORDER_API_BASE=https://replace-me.example.com

# V2：在启动进程前设置环境变量。本服务不自动读取 .env 文件。
LOGISUPPLY_DB_PATH=order_api/data/logisupply.db
LOGISUPPLY_PUBLIC_URL=https://replace-me.example.com
# 分别生成两个不同的随机密钥，勿使用这些占位值部署。
LOGISUPPLY_TOOL_API_KEY=replace-with-random-tool-key
LOGISUPPLY_ADMIN_API_KEY=replace-with-different-random-operator-key

# 云端生产入口读取平台 PORT，SQLite 数据库必须放在挂载卷内。
# Railway 示例：LOGISUPPLY_DB_PATH=/data/logisupply.db
# PORT=8018
