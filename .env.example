# 本机Dify；完整启动入口为start-local.ps1，密钥由本地初始化脚本生成。
DIFY_API_BASE=http://127.0.0.1:8088/v1
DIFY_API_KEY=
DIFY_CONSOLE_URL=http://127.0.0.1:8088
LOGISUPPLY_ALLOW_LOCAL_DIFY_HTTP=true

# 本机Dify容器通过共享网络调用FastAPI，浏览器从8020进入。
ORDER_API_BASE=http://logisupply-api:8018

# 启动入口serve/run_demo读取仓库根.env；已有环境变量优先。
LOGISUPPLY_DB_PATH=order_api/data/logisupply.db
LOGISUPPLY_PUBLIC_URL=http://127.0.0.1:8020
# 分别生成两个不同的随机密钥，勿使用这些占位值部署。
LOGISUPPLY_TOOL_API_KEY=replace-with-random-tool-key
LOGISUPPLY_ADMIN_API_KEY=replace-with-different-random-operator-key

# 云端生产入口读取平台 PORT，SQLite 数据库必须放在挂载卷内。
# Railway 示例：LOGISUPPLY_DB_PATH=/data/logisupply.db
# PORT=8018

# 混合检索RAG（2026-10-19）
# Local config only. Environment variables take precedence. Never commit .env.
RAG_MODE=hybrid
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
# 可选：本机 Dify 的 Qwen API 密钥；不填则复用 EMBEDDING_API_KEY。
LLM_API_KEY=
RAG_TIMEOUT_SECONDS=8
RAG_MIN_DENSE_SCORE=0.45
# Milvus standalone (compose.rag.yml), or use a .db path for optional Milvus Lite.
LOGISUPPLY_MILVUS_URI=http://127.0.0.1:19530
LOGISUPPLY_MILVUS_TOKEN=
